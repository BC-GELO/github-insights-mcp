# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Personal access token. Optional for public data (60 requests/hour without one);
# a fine-grained, read-only token raises the limit to 5,000 requests/hour.
GITHUB_TOKEN=

# Whose repositories the tools read.
GITHUB_USERNAME=BC-GELO

# Optional: point at GitHub Enterprise Server, e.g. https://ghe.example.com/api/v3
# GITHUB_API_BASE=https://api.github.com
